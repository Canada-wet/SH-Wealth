ANTHROPIC_REASONING_MODEL=claude-sonnet-5-5
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
# Multi-model council: server-only; do not prefix secrets with NEXT_PUBLIC_.
QWEN_API_KEY=
# Official workspace endpoint, e.g. https://WORKSPACE.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# One Alibaba key supports verified Qwen/Kimi/GLM mappings; key and endpoint must be in the same region.
QWEN_BASE_URL=
# auto: existing original-vendor key first, otherwise Alibaba. No automatic retry/failover.
# Force alibaba or direct if desired. GLM Flash has no verified Alibaba mapping.
COUNCIL_GLM_CHANNEL=auto
COUNCIL_MOONSHOT_CHANNEL=auto
ZAI_API_KEY=
MOONSHOT_API_KEY=
GEMINI_API_KEY=
# Meta Model API (Muse Spark), not a WhatsApp or Facebook Graph token.
MODEL_API_KEY=
CRON_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://together-wealth.vercel.app
APP_URL=https://sh-wealth.vercel.app
# Server-only 32-byte base64 key. Back up before using; do not rotate casually.
NOTIFICATION_ENCRYPTION_KEY=
RESEND_API_KEY=
EMAIL_FROM=
# Alternative to Resend. Gmail: smtp.gmail.com / 465 / app password, not login password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
# Only after checking current Meta AI policy and account approval.
WHATSAPP_ALLOW_ADVISOR=0
