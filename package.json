{
  "name": "together-wealth",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:cloud": "RUN_SUPABASE_INTEGRATION=1 vitest run tests/cloud.live.test.ts tests/channels.live.test.ts",
    "test:ai": "RUN_OPENAI_INTEGRATION=1 vitest run tests/openai.live.test.ts",
    "test:router": "RUN_ROUTER_INTEGRATION=1 vitest run tests/router.live.test.ts",
    "test:search": "RUN_SEARCH_INTEGRATION=1 vitest run tests/search.live.test.ts",
    "test:voice": "RUN_VOICE_INTEGRATION=1 vitest run tests/voice.live.test.ts",
    "test:market": "RUN_MARKET_INTEGRATION=1 vitest run tests/market.live.test.ts",
    "test:e2e:cloud": "RUN_SUPABASE_E2E=1 playwright test tests/e2e/cloud.spec.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.6",
    "nodemailer": "^10.1.0",
    "openai": "^4.85.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.1",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "postcss": "^8.5.30"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/web-push": "^3.6.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
